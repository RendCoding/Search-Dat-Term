#!/usr/bin/env bash

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_DIR/../lib/search-dat-term.sh" ]]; then
    source "$SCRIPT_DIR/../lib/search-dat-term.sh"
elif [[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/search-dat-term/search-dat-term.sh" ]]; then
    source "${XDG_DATA_HOME:-$HOME/.local/share}/search-dat-term/search-dat-term.sh"
else
    echo "Search Dat Term: shared library not found. Re-run the installation steps." >&2
    exit 1
fi

command -v fzf >/dev/null 2>&1 || {
    echo "Please install fzf first."
    exit 1
}

declare -A apps
entries=()

while IFS= read -r -d '' file; do
    name=$(awk -F= '
        /^\[Desktop Entry\]$/ { section=1; next }
        /^\[/ { section=0 }
        section && /^Name=/ { sub(/^Name=/, ""); print; exit }
    ' "$file")

    [[ -z "$name" ]] && continue
    grep -q '^Type=Application' "$file" || continue
    grep -q '^NoDisplay=true' "$file" && continue
    grep -q '^Hidden=true' "$file" && continue

    id=${file##*/}
    id=${id%.desktop}
    entry="$name  [$id]"
    apps["$entry"]=$id
    entries+=("$entry")
done < <(sdt_find_desktop_files)

(("${#entries[@]}" > 0)) || {
    echo "Search Dat Term: no visible application desktop entries were found." >&2
    exit 0
}

choice=$(printf '%s\n' "${entries[@]}" |
    sort -fu | fzf --prompt='Choose app > ' --layout=reverse)

[[ -z "$choice" ]] && exit 0

id=${apps[$choice]}
name=${choice%  \[*}

printf 'Nickname for %s: ' "$name"
read -r nick

if [[ ! "$nick" =~ ^[a-zA-Z][a-zA-Z0-9_-]*$ ]]; then
    echo "Invalid nickname. Start with a letter; use only letters, numbers, _ or -."
    exit 1
fi

file=$(sdt_nicknames_file)
mkdir -p "$(dirname -- "$file")"
touch "$file"

if [[ -f "$file" ]]; then
    sed -i "/^${nick}() {$/,/^}$/d" "$file"
fi

{
    printf '%s() {\n' "$nick"
    printf '    sdt-launch %q >/dev/null 2>&1 &\n' "$id"
    printf '}\n\n'
} >> "$file"

startup_file=$(sdt_enable_nicknames "$file")

echo "Saved: $nick -> $name"
printf 'Automatically enabled nickname loading in: %s\n' "$startup_file"
echo "Open a new Bash session to use the nickname."
