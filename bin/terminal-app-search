#!/usr/bin/env bash

command -v fzf >/dev/null || exit 1
command -v gtk-launch >/dev/null || {
    echo "gtk-launch is not installed"
    read -r
    exit 1
}

declare -A apps
entries=()

while IFS= read -r -d '' file; do
    name=$(awk -F= '
        /^\[Desktop Entry\]$/ { in_entry=1; next }
        /^\[/ { in_entry=0 }
        in_entry && /^Name=/ { sub(/^Name=/, ""); print; exit }
    ' "$file")

    [[ -z "$name" ]] && continue
    grep -q '^Type=Application' "$file" || continue
    grep -q '^NoDisplay=true' "$file" && continue
    grep -q '^Hidden=true' "$file" && continue

    id=${file##*/}
    id=${id%.desktop}

    apps["$name  [$id]"]=$id
    entries+=("$name  [$id]")
done < <(
    find "$HOME/.local/share/applications" \
         /usr/share/applications \
         /var/lib/flatpak/exports/share/applications \
         "$HOME/.local/share/flatpak/exports/share/applications" \
         -type f -name '*.desktop' -print0 2>/dev/null
)

choice=$(printf '%s\n' "${entries[@]}" |
    sort -fu |
    fzf --prompt='Launch app > ' --height=100% --layout=reverse)

[[ -z "$choice" ]] && exit 0

gtk-launch "${apps[$choice]}" >/dev/null 2>&1 &
